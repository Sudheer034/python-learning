import numpy as np

array = np.array([155, 123], dtype=np.uint8) # there exists float16 :)

# numpy has C datatypes, can be accessed by this module

print(f"array: {array}")
print(f"type: {array.dtype}") # for accessing boolean, the datatype is bool_, and string is str_
print(f"Bytes: {array.nbytes}")

# the numpy for strings results the datatype as Ux, here x is number of maximum # of characters

# to convert from one data type to another of numpy library

print("_______________________________")

array1 = array.astype(np.float16)

print(f"array: {array1}")
print(f"type: {array1.dtype}")
print(f"Bytes: {array1.nbytes}")
